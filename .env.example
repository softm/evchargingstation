# Server / collector only. Do not prefix this secret with PUBLIC_ or VITE_.
DATA_GO_KR_SERVICE_KEY=
# Public Maps Application Key ID from the user's existing care map.
PUBLIC_NAVER_MAP_CLIENT_ID=etfcybk8vf
# Empty uses static snapshots; /api uses the included Python server.
PUBLIC_EV_API_BASE_URL=
PUBLIC_EV_DATA_BASE_URL=./data
PUBLIC_EV_STATUS_API_BASE_URL=https://evchargingstation-status.vercel.app/api
PUBLIC_ADFIT_ENABLED=false
PUBLIC_ADFIT_LIST_1_UNIT=
PUBLIC_ADFIT_LIST_2_UNIT=
PUBLIC_ADFIT_LIST_3_UNIT=
PUBLIC_ADFIT_BOTTOM_DESKTOP_UNIT=
PUBLIC_ADFIT_BOTTOM_MOBILE_UNIT=
PUBLIC_ADFIT_WELCOME_UNIT=
# Legacy alias for list1, used only if PUBLIC_ADFIT_LIST_1_UNIT is empty.
PUBLIC_ADFIT_BANNER_UNIT=
# Apply these before launching Python. .env is not automatically loaded.
MAX_API_CALLS_PER_RUN=100
MAX_API_CALLS_PER_DAY=1000
STATUS_POLL_INTERVAL_SECONDS=300
EV_ALLOWED_ORIGINS=
